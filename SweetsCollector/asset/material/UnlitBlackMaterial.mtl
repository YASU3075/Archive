# UnlitBlackMaterial.mtl
name		= BlackUnlit
vertex_shader	= shader\\unlitTextureVS.cso
pixel_shader	= shader\\unlitTexturePS.cso
texture		= none
texture_enable	= 0

# マテリアル色
ambient		= 0.1,0.1,0.1,1.0
diffuse		= 0.0,0.0,0.0,1.0
specular	= 0.1,0.1,0.1,1.0
shininess	= 0.0

# UV
uv_scale        = 1.0,1.0
uv_offset       = 0.0,0.0