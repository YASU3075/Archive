# ScoreLabelMaterial.mtl
name		= ScoreLabel
vertex_shader	= shader\\unlitTextureVS.cso
pixel_shader	= shader\\unlitTexturePS.cso
texture		= asset\\texture\\score.png
texture_enable	= 1

# マテリアル色
ambient		= 0.5,0.5,0.5,1.0
diffuse		= 1.0,1.0,1.0,1.0
specular	= 0.1,0.1,0.1,1.0
emission        = 0.1,0.1,0.1,1.0
shininess	= 0.1

# UV
uv_scale        = 1.0,1.0
uv_offset       = 0.0,0.0